<Window x:Class="UrlBlockListWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser URL Blocker"
        Width="1100"
        Height="820"
        MinWidth="900"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F8"
        FontFamily="Segoe UI"
        Icon="/UrlBlockListWpfApp;component/Assets/AppIcon.ico">

    <Window.Resources>

        <LinearGradientBrush x:Key="HeaderGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#312E81"
                          Offset="0"/>
            <GradientStop Color="#4F46E5"
                          Offset="0.55"/>
            <GradientStop Color="#2563EB"
                          Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow"
                          Color="#334155"
                          BlurRadius="18"
                          ShadowDepth="3"
                          Opacity="0.15"/>

        <Style x:Key="ModernTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Padding"
                    Value="15,0"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="#1E293B"/>

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#CBD5E1"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="CaretBrush"
                    Value="#4F46E5"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="TextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="#4F46E5"/>

                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderThickness"
                                        Value="2"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="TextBoxBorder"
                                        Property="Opacity"
                                        Value="0.6"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="RoundedButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="MinWidth"
                    Value="115"/>

            <Setter Property="Padding"
                    Value="20,8"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.72"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#94A3B8"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.65"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="SmallDeleteButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundedButtonStyle}">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="MinWidth"
                    Value="105"/>

            <Setter Property="Padding"
                    Value="13,5"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Background"
                    Value="#DC2626"/>

        </Style>

        <Style x:Key="BrowserCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <Border x:Name="Container"
                                Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="CheckBoxBorder"
                                        Width="22"
                                        Height="22"
                                        Background="#F8FAFC"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1.5"
                                        CornerRadius="6"
                                        VerticalAlignment="Center">

                                    <Path x:Name="CheckMark"
                                          Data="M 4 10 L 8 14 L 17 5"
                                          Stroke="White"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>

                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  Margin="11,0,10,0"
                                                  Content="{TemplateBinding Tag}"
                                                  VerticalAlignment="Center"/>

                                <ContentPresenter Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Container"
                                        Property="Background"
                                        Value="#F8FAFC"/>

                                <Setter TargetName="Container"
                                        Property="BorderBrush"
                                        Value="#A5B4FC"/>

                            </Trigger>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="CheckBoxBorder"
                                        Property="Background"
                                        Value="#4F46E5"/>

                                <Setter TargetName="CheckBoxBorder"
                                        Property="BorderBrush"
                                        Value="#4F46E5"/>

                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>

                                <Setter TargetName="Container"
                                        Property="BorderBrush"
                                        Value="#818CF8"/>

                                <Setter TargetName="Container"
                                        Property="Background"
                                        Value="#EEF2FF"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="Container"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="RegistryPreviewStyle"
               TargetType="ListBox">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="8"/>

            <Setter Property="FontFamily"
                    Value="Cascadia Mono, Consolas"/>

            <Setter Property="FontSize"
                    Value="12.5"/>

            <Setter Property="Foreground"
                    Value="#334155"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Auto"/>

            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto"/>

        </Style>

        <Style TargetType="ListBoxItem">

            <Setter Property="Padding"
                    Value="6,4"/>

            <Setter Property="Margin"
                    Value="0,1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#EEF2FF"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#C7D2FE"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderGradient}"
                Padding="32,24">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="62"
                        Height="62"
                        CornerRadius="14"
                        Background="#26FFFFFF"
                        Margin="0,0,18,0">

                    <Image Source="/UrlBlockListWpfApp;component/Assets/AppIcon.ico"
                           Width="46"
                           Height="46"
                           Stretch="Uniform"/>

                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="Browser URL Blocker"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Manage blocked websites for Microsoft Edge and Google Chrome"
                               Margin="0,5,0,0"
                               Foreground="#DDE7FF"
                               FontSize="14"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1"
              Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Input section -->
            <Border Grid.Row="0"
                    Margin="0,0,0,22"
                    Padding="22"
                    Background="White"
                    CornerRadius="14"
                    Effect="{StaticResource CardShadow}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Add a website"
                               Foreground="#0F172A"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid>

                            <TextBox x:Name="UrlTextBox"
                                     Text="{Binding Url,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}"/>

                            <TextBlock Text="Enter a URL, for example: youtube.com"
                                       Foreground="#94A3B8"
                                       FontSize="14"
                                       Margin="16,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding Text,
                                                                          ElementName=UrlTextBox}"
                                                         Value="">

                                                <Setter Property="Visibility"
                                                        Value="Visible"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </Grid>
                        
                        <Button Grid.Column="1"
                                Content="⟳  Load"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#FF808080"
                                Margin="14,0,0,0"/>

                        <Button Grid.Column="2"
                                Content="＋  Add"
                                Command="{Binding ReadAndAddCommand}"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#4F46E5"
                                Margin="14,0,0,0"/>

                        <Button Grid.Column="3"
                                Content="✓  Apply"
                                Command="{Binding ApplyCommand}"
                                Style="{StaticResource RoundedButtonStyle}"
                                Background="#059669"
                                Margin="10,0,0,0"/>

                    </Grid>

                    <!-- Restart options -->
                    <Border Grid.Row="2"
                            Margin="0,18,0,0"
                            Padding="16"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>

                                <TextBlock Text="Browser restart options"
                                           Foreground="#0F172A"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Choose which browsers should restart after applying the policy."
                                           Foreground="#64748B"
                                           FontSize="12"
                                           Margin="0,4,0,0"/>

                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0,14,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          Content="Restart Google Chrome"
                                          IsChecked="{Binding RestartChrome,
                                                              Mode=TwoWay}"
                                          Style="{StaticResource BrowserCheckBoxStyle}">

                                    <CheckBox.Tag>

                                        <Border Width="38"
                                                Height="38"
                                                Background="White"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="9">

                                            <Image Source="/UrlBlockListWpfApp;component/Assets/ChromeIcon.png"
                                                   Width="27"
                                                   Height="27"
                                                   Stretch="Uniform"/>

                                        </Border>

                                    </CheckBox.Tag>

                                </CheckBox>

                                <CheckBox Grid.Column="2"
                                          Content="Restart Microsoft Edge"
                                          IsChecked="{Binding RestartEdge,
                                                              Mode=TwoWay}"
                                          Style="{StaticResource BrowserCheckBoxStyle}">

                                    <CheckBox.Tag>

                                        <Border Width="38"
                                                Height="38"
                                                Background="White"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="9">

                                            <Image Source="/UrlBlockListWpfApp;component/Assets/EdgeIcon.png"
                                                   Width="27"
                                                   Height="27"
                                                   Stretch="Uniform"/>

                                        </Border>

                                    </CheckBox.Tag>

                                </CheckBox>

                            </Grid>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

            <!-- Browser previews -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Edge preview -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Effect="{StaticResource CardShadow}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="18,13"
                                CornerRadius="14,14,0,0"
                                Background="#ECFEFF">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="10"
                                        Background="White"
                                        BorderBrush="#CFFAFE"
                                        BorderThickness="1"
                                        Margin="0,0,12,0">

                                    <Image Source="/UrlBlockListWpfApp;component/Assets/EdgeIcon.png"
                                           Width="29"
                                           Height="29"
                                           Stretch="Uniform"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Microsoft Edge"
                                               Foreground="#164E63"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Select an entry and click Delete"
                                               Foreground="#0E7490"
                                               FontSize="12"/>

                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="🗑  Delete"
                                        Command="{Binding DeleteEdgeLineCommand}"
                                        Style="{StaticResource SmallDeleteButtonStyle}"
                                        VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <Border Grid.Row="1"
                                Margin="16"
                                CornerRadius="9"
                                ClipToBounds="True">

                            <ListBox ItemsSource="{Binding EdgeFileLines}"
                                     SelectedItem="{Binding SelectedEdgeLine,
                                                            Mode=TwoWay}"
                                     Style="{StaticResource RegistryPreviewStyle}">

                                <ListBox.ItemTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="NoWrap"/>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                        </Border>

                    </Grid>

                </Border>

                <!-- Chrome preview -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="14"
                        Effect="{StaticResource CardShadow}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="18,13"
                                CornerRadius="14,14,0,0"
                                Background="#FFF7ED">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="10"
                                        Background="White"
                                        BorderBrush="#FED7AA"
                                        BorderThickness="1"
                                        Margin="0,0,12,0">

                                    <Image Source="/UrlBlockListWpfApp;component/Assets/ChromeIcon.png"
                                           Width="29"
                                           Height="29"
                                           Stretch="Uniform"/>

                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Google Chrome"
                                               Foreground="#7C2D12"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="Select an entry and click Delete"
                                               Foreground="#C2410C"
                                               FontSize="12"/>

                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="🗑  Delete"
                                        Command="{Binding DeleteChromeLineCommand}"
                                        Style="{StaticResource SmallDeleteButtonStyle}"
                                        VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <Border Grid.Row="1"
                                Margin="16"
                                CornerRadius="9"
                                ClipToBounds="True">

                            <ListBox ItemsSource="{Binding ChromeFileLines}"
                                     SelectedItem="{Binding SelectedChromeLine,
                                                            Mode=TwoWay}"
                                     Style="{StaticResource RegistryPreviewStyle}">

                                <ListBox.ItemTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="NoWrap"/>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                        </Border>

                    </Grid>

                </Border>

            </Grid>

            <!-- Status -->
            <Border Grid.Row="2"
                    Margin="0,22,0,0"
                    Padding="16,13"
                    Background="White"
                    CornerRadius="11"
                    Effect="{StaticResource CardShadow}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="10"
                             Height="10"
                             Fill="#22C55E"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               Foreground="#475569"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="Working..."
                                   Foreground="#4F46E5"
                                   FontSize="12"
                                   Margin="0,0,10,0">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsBusy}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                        <ProgressBar Width="130"
                                     Height="6"
                                     IsIndeterminate="True"
                                     Foreground="#4F46E5"
                                     Background="#E0E7FF">

                            <ProgressBar.Style>

                                <Style TargetType="ProgressBar">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsBusy}"
                                                     Value="True">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </ProgressBar.Style>

                        </ProgressBar>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>